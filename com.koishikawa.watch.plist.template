<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.koishikawa.watch</string>

	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__PROJECT_DIR__/bin/watch.mjs</string>
		<string>--tick</string>
	</array>

	<key>WorkingDirectory</key>
	<string>__PROJECT_DIR__</string>

	<!-- 5分ごとに --tick を叩く。軽い巡回か全件走査かは tick 自身が
	     状態ファイルの fullScanAt と config の intervalMinutes から判断する -->
	<key>StartInterval</key>
	<integer>300</integer>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>__PROJECT_DIR__/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__PROJECT_DIR__/launchd.err.log</string>
</dict>
</plist>
